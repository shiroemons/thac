{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:recommended",
		"schedule:weekdays",
		":automergeMinor",
		":automergePatch"
	],
	"labels": ["dependencies"],
	"rangeStrategy": "bump",
	"lockFileMaintenance": {
		"enabled": true,
		"schedule": ["before 5am on monday"]
	},
	"packageRules": [
		{
			"description": "Patch updates - auto-merge",
			"matchUpdateTypes": ["patch"],
			"automerge": true,
			"groupName": "patch updates",
			"groupSlug": "patch"
		},
		{
			"description": "Minor updates - individual PRs",
			"matchUpdateTypes": ["minor"],
			"automerge": false
		},
		{
			"description": "Major updates - individual PRs with label",
			"matchUpdateTypes": ["major"],
			"automerge": false,
			"labels": ["dependencies", "major"]
		},
		{
			"description": "Dev dependencies - group together",
			"matchDepTypes": ["devDependencies"],
			"matchUpdateTypes": ["minor", "patch"],
			"groupName": "dev dependencies",
			"groupSlug": "dev-deps"
		},
		{
			"description": "TypeScript ecosystem",
			"matchPackagePatterns": ["^@types/", "^typescript$"],
			"groupName": "typescript",
			"groupSlug": "typescript"
		},
		{
			"description": "TanStack packages",
			"matchPackagePatterns": ["^@tanstack/"],
			"groupName": "tanstack",
			"groupSlug": "tanstack"
		},
		{
			"description": "Drizzle packages",
			"matchPackagePatterns": ["^drizzle-"],
			"groupName": "drizzle",
			"groupSlug": "drizzle"
		}
	],
	"ignoreDeps": [],
	"prConcurrentLimit": 5,
	"prHourlyLimit": 2
}
