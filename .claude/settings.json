{
	"includeCoAuthoredBy": false,
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Write|Edit",
				"hooks": [
					{
						"type": "command",
						"command": "cd \"$CLAUDE_PROJECT_DIR\" && pnpm check || true"
					}
				]
			}
		],
		"Stop": [
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "afplay /System/Library/Sounds/Glass.aiff"
					}
				]
			}
		]
	},
	"enabledPlugins": {
		"hono-skill@hono-skill": true,
		"ui-ux-pro-max@ui-ux-pro-max-skill": true
	}
}
