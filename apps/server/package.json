{
	"name": "server",
	"main": "src/index.ts",
	"type": "module",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc -b",
		"dev": "SERVER_ENTRYPOINT=1 tsx watch src/index.ts",
		"start": "SERVER_ENTRYPOINT=1 node dist/index.js",
		"test": "vitest run --config ../../vitest.config.ts apps/server",
		"test:watch": "vitest --config ../../vitest.config.ts apps/server",
		"test:coverage": "vitest run --config ../../vitest.config.ts --coverage apps/server",
		"test:ci": "vitest run --config ../../vitest.config.ts --coverage --coverage.reporter=lcov apps/server"
	},
	"dependencies": {
		"@hono/node-server": "^2.1.0",
		"@thac/auth": "workspace:*",
		"@thac/db": "workspace:*",
		"@thac/search": "workspace:*",
		"@thac/utils": "workspace:*",
		"dotenv": "catalog:",
		"hono": "^4.13.0",
		"hono-rate-limiter": "^0.5.3",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@electric-sql/pglite": "catalog:",
		"@thac/config": "workspace:*",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "^4.1.10",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"nanoid": "catalog:",
		"tsdown": "^0.22.14",
		"tsx": "4.23.9",
		"typescript": "catalog:"
	}
}
