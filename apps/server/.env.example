# Database Configuration
# devbox利用時は環境変数が自動設定されるため、通常この設定は不要です
# Docker Compose利用時もdocker-compose.ymlで設定済みです
DATABASE_URL=postgresql://localhost:5432/thac
# 本番環境の場合:
# DATABASE_URL=postgresql://user:password@host:5432/thac

# Authentication
BETTER_AUTH_SECRET=your-secret-key
BETTER_AUTH_URL=http://localhost:3001

# CORS
CORS_ORIGIN=http://localhost:3000

# Meilisearch
MEILI_MASTER_KEY=development_master_key
MEILI_URL=http://meilisearch:7700

# OAuth Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
