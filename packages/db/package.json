{
	"name": "@thac/db",
	"type": "module",
	"exports": {
		".": {
			"default": "./src/index.ts"
		},
		"./*": {
			"default": "./src/*.ts"
		},
		"./schema/*": {
			"default": "./src/schema/*.ts"
		},
		"./utils/*": {
			"default": "./src/utils/*.ts"
		}
	},
	"scripts": {
		"check-types": "tsc --noEmit",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:studio": "drizzle-kit studio",
		"db:migrate": "drizzle-kit migrate",
		"db:seed": "tsx src/seed-master.ts && tsx src/seed-official.ts && tsx src/seed-official-links.ts",
		"db:seed:master": "tsx src/seed-master.ts",
		"db:seed:official": "tsx src/seed-official.ts",
		"db:seed:official-links": "tsx src/seed-official-links.ts",
		"db:truncate": "tsx src/truncate-non-master.ts",
		"test": "vitest run --config ../../vitest.config.ts packages/db"
	},
	"devDependencies": {
		"@electric-sql/pglite": "catalog:",
		"drizzle-kit": "^0.31.10",
		"typescript": "catalog:",
		"@thac/config": "workspace:*",
		"tsx": "4.23.9",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"dotenv": "catalog:",
		"drizzle-orm": "^0.45.2",
		"drizzle-zod": "^0.8.3",
		"postgres": "catalog:",
		"typeid-js": "^1.2.0",
		"zod": "catalog:"
	}
}
