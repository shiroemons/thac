{
	"name": "thac",
	"private": true,
	"type": "module",
	"scripts": {
		"postinstall": "command -v git >/dev/null 2>&1 && lefthook install || true",
		"check": "biome check --write .",
		"dev": "turbo dev",
		"build": "turbo build",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"check-types": "turbo check-types",
		"dev:native": "turbo -F native dev",
		"dev:web": "turbo -F web dev",
		"dev:server": "turbo -F server dev",
		"db:push": "turbo -F @thac/db db:push",
		"db:studio": "turbo -F @thac/db db:studio",
		"db:generate": "turbo -F @thac/db db:generate",
		"db:migrate": "turbo -F @thac/db db:migrate",
		"db:seed": "pnpm --dir packages/auth db:seed:admin && pnpm --dir packages/db db:seed",
		"db:truncate": "pnpm --dir packages/db db:truncate"
	},
	"dependencies": {
		"@tanstack/react-router": "^1.168.23",
		"@tanstack/react-router-devtools": "^1.166.13",
		"@tanstack/react-router-with-query": "^1.130.17",
		"@tanstack/react-start": "^1.167.42",
		"better-auth": "^1.6.8",
		"date-fns": "^4.1.0",
		"dotenv": "catalog:",
		"typeid-js": "^1.2.0",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.12",
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "^4.1.6",
		"lefthook": "^2.1.6",
		"turbo": "^2.9.6",
		"typescript": "catalog:",
		"vitest": "^4.1.6",
		"web": "workspace:*"
	},
	"packageManager": "pnpm@11.1.2",
	"overrides": {
		"glob": ">=13.0.0",
		"diff": ">=8.0.3",
		"undici": ">=7.18.2"
	}
}
