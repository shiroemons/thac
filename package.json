{
	"name": "thac",
	"private": true,
	"type": "module",
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.2.3",
			"zod": "^4.3.6",
			"typescript": "^5",
			"@types/bun": "^1.3.8",
			"better-auth": "1.4.18",
			"@libsql/client": "0.17.0",
			"libsql": "0.5.22",
			"nanoid": "^5.1.6"
		}
	},
	"scripts": {
		"postinstall": "command -v git >/dev/null 2>&1 && lefthook install || true",
		"check": "bunx biome check --write .",
		"dev": "turbo dev",
		"build": "turbo build",
		"test": "turbo test",
		"check-types": "turbo check-types",
		"dev:native": "turbo -F native dev",
		"dev:web": "turbo -F web dev",
		"dev:server": "turbo -F server dev",
		"db:push": "turbo -F @thac/db db:push",
		"db:studio": "turbo -F @thac/db db:studio",
		"db:generate": "turbo -F @thac/db db:generate",
		"db:migrate": "turbo -F @thac/db db:migrate",
		"db:seed": "bun run --cwd packages/db db:seed",
		"db:truncate": "bun run --cwd packages/db db:truncate"
	},
	"dependencies": {
		"@tanstack/react-router": "^1.157.18",
		"@tanstack/react-router-devtools": "^1.157.18",
		"@tanstack/react-router-with-query": "^1.130.17",
		"@tanstack/react-start": "^1.157.18",
		"date-fns": "^4.1.0",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.13",
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@types/bun": "catalog:",
		"lefthook": "^2.0.16",
		"turbo": "^2.8.1",
		"typescript": "catalog:",
		"web": "workspace:*"
	},
	"packageManager": "bun@1.3.8",
	"overrides": {
		"glob": ">=13.0.0",
		"diff": ">=8.0.3",
		"undici": ">=7.18.2"
	}
}
